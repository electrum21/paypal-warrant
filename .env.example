# PayPal SANDBOX credentials only. Never commit the real .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after you register a webhook in the PayPal dashboard (needs a public URL, e.g. Render).
PAYPAL_WEBHOOK_ID=
DATABASE_PATH=./warrant.db
PORT=8787
# Required to open the approval screen and call /api/* admin routes. Use a long random string.
ADMIN_TOKEN=
# Optional. Without it, dispute explanations use a built-in template instead of an LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. If set, Gemini is used instead of Anthropic for the explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# true = refuse purchases that break the mandate at checkout (HTTP 422). Default: record them and defend later.
ENFORCE_MANDATE=false
# The merchant id that mandates must list in allowedMerchantIds.
MERCHANT_ID=warrant-demo-merchant
