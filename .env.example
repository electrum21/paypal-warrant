# PayPal SANDBOX credentials only. Never commit the real .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after you register a webhook in the PayPal dashboard (needs a public URL, e.g. Render).
PAYPAL_WEBHOOK_ID=
DATABASE_PATH=./warrant.db
PORT=8787
APP_URL=http://localhost:8787
# Optional separate PayPal app credentials for "Log in with PayPal". If unset, REST app credentials are used.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
PAYPAL_LOGIN_SCOPES=openid profile email
AUTH_SESSION_HOURS=24
# Required to open the approval screen and call /api/* admin routes. Use a long random string.
ADMIN_TOKEN=
# Optional second token with identical access, for handing to hackathon judges without exposing ADMIN_TOKEN.
# Only set this on the public deployment, and unset/rotate it once judging ends.
JUDGE_TOKEN=
# Optional. Without it, dispute explanations use a built-in template instead of an LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. If set, Gemini is used instead of Anthropic for the explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# true = refuse purchases that break the mandate at checkout (HTTP 422). Default: record them and defend later.
ENFORCE_MANDATE=false
# The merchant id that mandates must list in allowedMerchantIds.
MERCHANT_ID=warrant-demo-merchant
# Optional sponsor integrations. Leave unset to use the offline/local adapters.
CHANNEL3_URL=
CHANNEL3_API_KEY=
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=warrant-agent-events
ZAPIER_WEBHOOK_URL=
# Dispute cases for precedent retrieval (semantic + keyword). Created automatically.
ELASTIC_CASE_INDEX=warrant-dispute-cases
# Shared secret a Zapier Zap sends as x-warrant-evidence-secret when posting evidence back (16+ characters).
# Lets a Zap add delivery proof without holding the admin token, which can approve responses.
EVIDENCE_WEBHOOK_SECRET=
# AG Studio agent. Studio calls an OpenAI Responses-compatible endpoint THROUGH Warrant, so this key stays on the server.
STUDIO_LLM_URL=https://api.openai.com/v1/responses
STUDIO_LLM_API_KEY=
STUDIO_LLM_MODEL=
# Set to "gemini" to run the Studio agent on GEMINI_API_KEY instead - no OpenAI account needed. Ignores
# STUDIO_LLM_URL/API_KEY/MODEL above; also resolves PAYPAL_MCP_ENABLED tool calls itself since Gemini has no
# native MCP connector the way OpenAI's Responses API does.
STUDIO_LLM_PROVIDER=openai
# Optional PayPal MCP context for the Studio analyst. Sandbox only; read tools are allow-listed in the server.
PAYPAL_MCP_ENABLED=false
PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com/sse
